<%= turbo_stream.update dom_id(@user, :sign_in_link) do %>
  <div class="linkrow mt-3 pl-[49px]">
    <input class="input" type="text" readonly value="<%= @sign_in_link %>"
           aria-label="Sign-in link for <%= @user.name %>" onfocus="this.select()">
    <%= render 'posts/copy_link', url: @sign_in_link, label: 'Copy' %>
  </div>
  <p class="hint mt-2 pl-[49px]">It works once, within the hour.</p>
<% end %>
