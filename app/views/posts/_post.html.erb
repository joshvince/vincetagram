<article class="post" style="<%= post_tint_style(post) %>" data-controller="post">
  <% if post.video.attached? %>
    <div class="media" style="<%= post_media_style(post) %>" data-post-target="media">
      <%= render 'posts/video', post: %>
    </div>
  <% else %>
    <%= link_to post_path(post), class: 'media', style: post_media_style(post, crop: true),
                                 aria: { label: "Open #{post.user.name}'s photo" },
                                 data: { turbo_frame: '_top', post_target: 'media', action: 'post#expand' } do %>
      <%= render 'posts/image', post:, sizes: '(min-width: 640px) 640px, 100vw' %>
    <% end %>
  <% end %>
  <div class="plate">
    <div class="plate-head">
      <%= avatar post.user %>
      <div class="who">
        <b class="person-name" style="--h: <%= post.user.hue %>"><%= post.user.name %></b>
        <%= link_to "#{time_ago_in_words(post.created_at)} ago", post_path(post), class: 'ago', data: { turbo_frame: '_top' } %>
      </div>
      <%= render 'posts/copy_link', url: post_url(post), label: 'Copy link' %>
    </div>
    <% if post.caption.present? %>
      <p class="caption"><%= post.caption %></p>
    <% end %>
  </div>
</article>
