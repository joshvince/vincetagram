<% content_for :title, 'New post' %>
<% content_for :hide_dock, true %>
<% content_for :body_class, 'presented' %>

<div class="presented-page">
  <%= form_with model: @post, class: 'flex flex-1 flex-col', data: { controller: 'photo-form' } do |form| %>
    <div class="sheet-head">
      <h1>New post</h1>
      <%= link_to feed_path, class: 'icon-btn press', aria: { label: 'Close' }, data: { controller: 'back', action: 'back#go' } do %>
        <%= icon 'x' %>
      <% end %>
    </div>

    <div class="sheet-body">
      <% if @post.errors.any? %>
        <div class="alert" role="alert">
          <% @post.errors.each do |error| %>
            <p><%= error.full_message %></p>
          <% end %>
        </div>
      <% end %>

      <div class="flex flex-col gap-3" data-photo-form-target="chooser">
        <label class="tile press">
          <%= form.file_field :photo, accept: 'image/*', class: 'sr-only',
                                      data: { photo_form_target: 'imageInput', action: 'photo-form#showImage' } %>
          <span class="ic"><%= icon 'image' %></span>
          <span><b>Upload a picture</b><small>From your photos or camera</small></span>
        </label>
        <label class="tile press">
          <%= form.file_field :video, accept: 'video/*', class: 'sr-only',
                                      data: { photo_form_target: 'videoInput', action: 'photo-form#showVideo' } %>
          <span class="ic"><%= icon 'video' %></span>
          <span><b>or a video</b><small>Up to 80 MB</small></span>
        </label>
        <p class="alert" role="alert" data-photo-form-target="error" hidden></p>
      </div>

      <div class="flex flex-col items-center gap-3" data-photo-form-target="preview" hidden>
        <img class="np-preview" alt="The photo you chose" data-photo-form-target="image" hidden>
        <video class="np-preview" controls playsinline data-photo-form-target="video" hidden></video>
        <button type="button" class="chip press bg-field" data-action="photo-form#reset">Choose a different one</button>
      </div>
    </div>

    <div class="np-bar" data-photo-form-target="submitBar" hidden>
      <%= form.label :caption, 'Caption', class: 'sr-only' %>
      <%= form.text_area :caption, rows: 2, class: 'input', placeholder: 'Add a caption for this picture' %>
      <%= form.submit 'Post', class: 'btn press', data: { turbo_submits_with: 'Posting…' } %>
    </div>
  <% end %>
</div>
