<% content_for :title, 'Check your email' %>

<main class="signin">
  <%= render 'backdrop' %>
  <div class="si-card glass">
    <% if flash.alert.present? %>
      <p class="alert" role="alert"><%= flash.alert %></p>
    <% end %>
    <%= render 'post_submit' %>

    <%= form_with model: @session, url: url_for(action: 'update'), scope: 'passwordless', method: 'patch',
                  class: 'flex flex-col gap-3.5', data: { turbo: 'false' } do |f| %>
      <div class="field">
        <%= f.label :token, t('.token') %>
        <%= f.text_field :token, required: true, autocomplete: 'one-time-code', autocapitalize: 'characters',
                                 spellcheck: false, class: 'input code' %>
      </div>
      <%= f.submit t('.confirm'), class: 'btn press' %>
    <% end %>
    <div class="flex items-center justify-between gap-2 text-[13.5px] text-ink-2">
      <span>Having problems? Contact the person who invited you.</span>
      <%= link_to 'Try again', auth_sign_in_path, class: 'min-h-10 content-center font-semibold text-ink' %>
    </div>
  </div>
</main>
