<div class="w-full max-w-(--breakpoint-md) flex flex-col justify-center items-center text-slate-700 mt-12 px-4">
  <% if flash.alert.present? %>
    <p class="w-80 p-3 rounded-md bg-red-50 text-red-600 text-sm text-center"><%= flash.alert %></p>
  <% end %>
  <%= render 'post_submit' %>

  <%= form_with model: @session, url: url_for(action: 'update'), scope: 'passwordless', method: 'patch', data: { turbo: 'false' } do |f| %>
    <div class="flex flex-col items-center mt-4">
      <%= f.label :token, t('.token'), class: 'text-sm mb-2' %>
      <%= f.text_field(
          :token,
          required: true,
          autocomplete: 'one-time-code',
          autocapitalize: 'characters',
          class: 'rounded-md border-2 border-slate-100 w-64 text-center uppercase tracking-widest'
        ) %>
      <%= f.submit t('.confirm'), class: "rounded-md bg-sky-500 text-white font-bold p-3 my-6 w-64 hover:cursor-pointer" %>
    </div>
  <% end %>
</div>
