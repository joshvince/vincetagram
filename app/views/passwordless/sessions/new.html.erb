<% content_for :title, 'Sign in' %>

<main class="signin">
  <%= render 'backdrop' %>
  <div class="si-card glass">
    <% if flash.alert.present? %>
      <p class="alert" role="alert"><%= flash.alert %></p>
    <% elsif flash.notice.present? %>
      <p class="hint"><%= flash.notice %></p>
    <% end %>
    <%= render 'pre_submit' %>

    <%= form_with model: @session, url: auth_sign_in_path, class: 'flex flex-col gap-3.5', data: { turbo: 'false' } do |f| %>
      <% email_field_name = :"passwordless[#{email_field}]" %>
      <div class="field">
        <%= label_tag email_field_name, 'Email address' %>
        <%= email_field_tag email_field_name, params.fetch(email_field_name, nil),
                            required: true, autocomplete: 'email', inputmode: 'email',
                            placeholder: 'Enter your email here', class: 'input' %>
      </div>
      <%= f.button type: 'submit', name: nil, class: 'btn press' do %>
        <%= icon 'mail' %><span><%= t('passwordless.sessions.new.submit') %></span>
      <% end %>
    <% end %>
  </div>
</main>
