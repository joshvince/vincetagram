<% content_for :title, "Edit #{@user.name}" %>
<% content_for :hide_dock, true %>
<% content_for :body_class, 'presented' %>

<div class="presented-page">
  <div class="sheet-head">
    <%= avatar @user %>
    <h1><%= @user.name %></h1>
    <%= link_to users_path, class: 'icon-btn press', aria: { label: 'Close' }, data: { controller: 'back', action: 'back#go' } do %>
      <%= icon 'x' %>
    <% end %>
  </div>
  <div class="sheet-body">
    <%= render 'form', user: @user, submit_button_label: 'Save changes' %>
    <hr class="my-2 border-line">
    <%= button_to 'Delete this user', user_path(@user), method: :delete, class: 'btn btn--soft press text-danger!',
                                                        form: { data: { turbo_confirm: "Delete #{@user.name} forever?" } } %>
  </div>
</div>
