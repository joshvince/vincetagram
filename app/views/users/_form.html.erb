<%= form_with model: user, class: 'flex flex-col gap-4' do |form| %>
  <% if user.errors.any? %>
    <div class="alert" role="alert">
      <% user.errors.each do |error| %>
        <p><%= error.full_message %></p>
      <% end %>
    </div>
  <% end %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, class: 'input', autocomplete: 'off', required: true %>
  </div>
  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, class: 'input', autocomplete: 'off', inputmode: 'email', required: true %>
  </div>
  <label class="hint flex items-start gap-2.5">
    <%= form.check_box :admin, disabled: true, class: 'mt-0.5 size-5 rounded' %>
    <span>Admin. This can't be set here; ask Josh to do it.</span>
  </label>
  <%= form.submit submit_button_label, class: 'btn press', data: { turbo_submits_with: 'Saving…' } %>
<% end %>
