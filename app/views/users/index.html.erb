<% content_for :title, 'People' %>

<header class="bar" data-controller="condense">
  <div class="bar-bg"></div>
  <div class="bar-in">
    <h1 class="bar-title">People</h1>
    <p class="bar-sub">
      <%= pluralize(@users.size, 'person') %> invited · <%= @users.count(&:last_signed_in_at) %> signed in
    </p>
    <%= link_to new_user_path, class: 'chip bar-act press' do %>
      <%= icon 'userplus', class: 'size-[17px]' %>New user
    <% end %>
  </div>
</header>

<main class="column gutter pb-[calc(var(--sb)+120px)]">
  <div class="bar-pad"></div>
  <div class="rows stagger">
    <% @users.each_with_index do |user, index| %>
      <div class="row" style="--i: <%= index %>">
        <div class="row-main">
          <% if user.admin? %>
            <div class="row-link"><%= render 'users/summary', user: %></div>
          <% else %>
            <%= link_to edit_user_path(user), class: 'row-link' do %>
              <%= render 'users/summary', user: %>
            <% end %>
          <% end %>
          <%= button_to user_sign_in_link_path(user), class: 'icon-btn press', form: { class: 'contents' },
                                                     aria: { label: "Create a sign-in link for #{user.name}" } do %>
            <%= icon 'key', class: 'size-5' %>
          <% end %>
        </div>
        <div id="<%= dom_id(user, :sign_in_link) %>"></div>
      </div>
    <% end %>
  </div>
</main>
