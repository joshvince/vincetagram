<% content_for :title, 'New user' %>
<% content_for :hide_dock, true %>
<% content_for :body_class, 'presented' %>

<div class="presented-page">
  <div class="sheet-head">
    <h1>New user</h1>
    <%= link_to users_path, class: 'icon-btn press', aria: { label: 'Close' }, data: { controller: 'back', action: 'back#go' } do %>
      <%= icon 'x' %>
    <% end %>
  </div>
  <div class="sheet-body">
    <p class="hint text-[14.5px]">
      When you submit this form, a link will be automatically sent to them, or they can try and log in themselves.
    </p>
    <%= render 'form', user: @user, submit_button_label: 'Create and invite new user' %>
  </div>
</div>
